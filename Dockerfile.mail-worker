# Private candidate only. No worker or paid compute is activated by this file.
FROM node:24.22.1-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/superhuman/api/package.json apps/superhuman/api/package.json
COPY apps/superhuman/collector/package.json apps/superhuman/collector/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace=@reconstruction/superhuman-api --include-workspace-root=false

# This leaf intentionally is not a root workspace. Install its exact native
# Linux binding and SDK lock independently from the API workspace.
WORKDIR /worker-dependencies
COPY apps/superhuman/vercel/package.json apps/superhuman/vercel/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:24.22.1-bookworm-slim
# Native libSQL uses the system CA bundle; Node's bundled roots do not supply it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && test -s /etc/ssl/certs/ca-certificates.crt \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /worker-dependencies/node_modules ./apps/superhuman/vercel/node_modules
COPY package.json ./package.json
COPY apps/superhuman/api/package.json ./apps/superhuman/api/package.json
COPY apps/superhuman/api/src ./apps/superhuman/api/src
COPY apps/superhuman/collector/package.json ./apps/superhuman/collector/package.json
COPY apps/superhuman/collector/src/protocol.ts ./apps/superhuman/collector/src/protocol.ts
COPY apps/superhuman/vercel/package.json ./apps/superhuman/vercel/package.json
COPY apps/superhuman/vercel/src ./apps/superhuman/vercel/src
USER node
EXPOSE 3002
CMD ["node", "--experimental-strip-types", "apps/superhuman/vercel/src/worker.ts"]
