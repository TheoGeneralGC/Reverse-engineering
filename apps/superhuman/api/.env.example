PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Only explicitly authorized test recipients may receive messages from this build.
APPROVED_TEST_RECIPIENTS=
# Exact authenticated account addresses explicitly approved for test sending.
# Empty sender or recipient lists disable all delivery.
APPROVED_TEST_SENDERS=
# Claude is the default. Select a model enabled for your Anthropic workspace.
# No model is silently selected, and no provider fallback occurs.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Required only if the Anthropic key is not scoped to a single workspace.
ANTHROPIC_WORKSPACE_ID=
# Optional existing adapter; requires an explicit AI_PROVIDER=openai selection.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional absolute path; defaults to the monorepo's ignored .local directory.
DATABASE_PATH=
# Conservative read budget below the new-project per-user quota (maximum 6000).
# The server uses short background slices and resumes imports automatically.
GMAIL_READ_QUOTA_UNITS_PER_MINUTE=4800
# Calendar stays disabled until Calendar API activation, scopes and service consent
# have been explicitly authorized. Uses the existing Google callback above.
GOOGLE_CALENDAR_ENABLED=false
# Calendar writes have separate approvals; Gmail send approvals do not apply.
# Empty account/calendar lists disable all event creation, editing and deletion.
APPROVED_CALENDAR_TEST_ACCOUNTS=
APPROVED_CALENDAR_TEST_IDS=
# Every attendee on a new or existing event must be explicitly approved.
APPROVED_CALENDAR_TEST_ATTENDEES=
# Calendar GET pacing is independent from Gmail quota; writes never auto-retry.
CALENDAR_READS_PER_MINUTE=60

# Optional read-tracking collector. Omit all tracking inputs to keep it off.
# Keep these repository examples commented; configure actual values privately.
# Present empty or partial values are invalid; they do not mean disabled.
# Requires a canonical HTTPS origin and an existing canonical private signer JSON
# file with exact 0600 mode in a trusted private parent. No key is generated here.
# Configuration alone does not verify public reachability/TLS or effective reads.
# TRACKING_PUBLIC_ORIGIN=https://collector.example.org
# TRACKING_MAIN_SIGNER_FILE=/absolute/private/tracking-main-signer.json
# TRACKING_COLLECTOR_TIMEOUT_MS=5000

# Optional matched operator evidence; source alone stays unverified.
# The verification file requires the source identity and the same canonical
# private 0600 file/parent rules as the signer. It does not trigger a host probe.
# TRACKING_COLLECTOR_SOURCE_IDENTITY=REPLACE_WITH_REVIEWED_LOWERCASE_SHA256
# TRACKING_OPERATOR_VERIFICATION_FILE=/absolute/private/tracking-operator-verification.json

# Generated Auto Draft persistence is local when omitted. Managed is an explicit
# trusted runtime mode requiring processing and provider automatic saving.
# It is separate from the account Responses switch and never authorizes Send.
# Present empty/unknown modes are invalid; no Main mode is changed by this example.
# AUTO_DRAFTS_PERSISTENCE=local
