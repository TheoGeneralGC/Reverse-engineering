{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "start_url": {
    "url": "http://127.0.0.1:5173"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "America/Los_Angeles",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    {
      "step_id": "inbox-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".thread-list[aria-label=\"Inbox\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "label-shortcut",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "body"
      },
      "key": "l",
      "timeout_ms": 10000
    },
    {
      "step_id": "label-focus",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "input[aria-label=\"Add label\"]:focus"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "filter-label",
      "action": "fill",
      "locator": {
        "kind": "role",
        "role": "textbox",
        "name": "Add label"
      },
      "value": {
        "source": "literal",
        "value": "Work"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "filtered-label",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".quick-results button.active:has-text(\"Work\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "page-errors"
    ],
    "after_each_step": [
      "dom",
      "accessibility",
      "url"
    ]
  }
}
