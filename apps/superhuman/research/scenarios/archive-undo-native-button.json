{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "start_url": {
    "url": "http://127.0.0.1:5173"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "America/Los_Angeles",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    {
      "step_id": "inbox-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".thread-list[aria-label=\"Inbox\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "jordan-present",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".mail-row[aria-label^=\"Jordan Lee:\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "archive-current",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "body"
      },
      "key": "e",
      "timeout_ms": 10000
    },
    {
      "step_id": "archive-removed",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".mail-row[aria-label^=\"Jordan Lee:\"]"
      },
      "state": "hidden",
      "timeout_ms": 10000
    },
    {
      "step_id": "undo-visible",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".toast button:has-text(\"Undo\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "undo-archive",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": ".toast button:has-text(\"Undo\")"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "undo-restored",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".mail-row[aria-label^=\"Jordan Lee:\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "native-menu-button",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "button[aria-label=\"Switch folders\"]"
      },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "navigation-open",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".navigation"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "thread-stays-closed",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".thread-view"
      },
      "state": "hidden",
      "timeout_ms": 10000
    },
    {
      "step_id": "composer-stays-closed",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".compose-view"
      },
      "state": "hidden",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "page-errors"
    ],
    "after_each_step": [
      "dom",
      "accessibility",
      "url"
    ]
  }
}
