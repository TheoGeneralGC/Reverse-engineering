{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "start_url": {
    "url": "http://127.0.0.1:5173"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "America/Los_Angeles",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    {
      "step_id": "inbox-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".thread-list[aria-label=\"Inbox\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "search-shortcut",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "body"
      },
      "key": "/",
      "timeout_ms": 10000
    },
    {
      "step_id": "search-focus",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "input[aria-label=\"Search email\"]:focus"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "search-query",
      "action": "fill",
      "locator": {
        "kind": "role",
        "role": "textbox",
        "name": "Search email"
      },
      "value": {
        "source": "literal",
        "value": "Jordan"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "search-submit",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "input[aria-label=\"Search email\"]"
      },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "jordan-result",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "section[aria-label=\"Search results\"] .mail-row[aria-label^=\"Jordan Lee: A few thoughts on the launch\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "expected-two-results",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "section[aria-label=\"Search results\"] .list-heading:has-text(\"2 conversations\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "page-errors"
    ],
    "after_each_step": [
      "dom",
      "accessibility",
      "url"
    ]
  }
}
