{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "start_url": {
    "url": "http://127.0.0.1:5173"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "America/Los_Angeles",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    {
      "step_id": "inbox-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".thread-list[aria-label=\"Inbox\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "open-thread",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "body"
      },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "thread-open",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".thread-view"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "reply-all-shortcut",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "body"
      },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "reply-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".compose-view"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "reply-subject",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "input[aria-label=\"Subject\"][value=\"Re: A few thoughts on the launch\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "reply-recipient",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".recipient-chip:has(button[aria-pressed][aria-label*=\"jordan@example.test\"])"
      },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "network",
      "page-errors"
    ],
    "after_each_step": [
      "dom",
      "accessibility",
      "url"
    ],
    "network": {
      "request_body": true,
      "response_body": false,
      "header_values": false
    }
  }
}
