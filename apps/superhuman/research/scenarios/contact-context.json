{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "start_url": {
    "url": "http://127.0.0.1:5173"
  },
  "environment": {
    "viewport": {
      "width": 1036,
      "height": 690,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "America/Los_Angeles",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    {
      "step_id": "inbox-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".thread-list[aria-label=\"Inbox\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "compose",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "body"
      },
      "key": "c",
      "timeout_ms": 10000
    },
    {
      "step_id": "owned-subject",
      "action": "fill",
      "locator": {
        "kind": "role",
        "role": "textbox",
        "name": "Subject"
      },
      "value": {
        "source": "literal",
        "value": "__CONTACT_SUBJECT__"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "pending-a",
      "action": "fill",
      "locator": {
        "kind": "role",
        "role": "combobox",
        "name": "To"
      },
      "value": {
        "source": "literal",
        "value": "rea-ctx-a@example.test"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "pending-keeps-author",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".contact-pane-email:text-is(\"alex@demo.local\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "commit-a",
      "action": "press",
      "locator": {
        "kind": "role",
        "role": "combobox",
        "name": "To"
      },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "a-shown",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".contact-pane-email:text-is(\"rea-ctx-a@example.test\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "settled-empty-contact-has-no-mail-section",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".contact-pane-mail"
      },
      "state": "hidden",
      "timeout_ms": 10000
    },
    {
      "step_id": "pending-b",
      "action": "fill",
      "locator": {
        "kind": "role",
        "role": "combobox",
        "name": "To"
